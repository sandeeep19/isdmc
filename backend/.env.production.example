# Copy to backend/.env.production on the server and fill in SECRET_KEY.
# Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DEBUG=False
SECRET_KEY=replace-me
ALLOWED_HOSTS=indianstudiodmc.com,www.indianstudiodmc.com,localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=https://www.indianstudiodmc.com,https://indianstudiodmc.com

# Set to False only while verifying over plain HTTP on the raw IP, before the
# TLS certificate exists. Must be True once the domain is live.
SECURE_SSL_REDIRECT=False
